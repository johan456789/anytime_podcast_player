<!-- Exclude secure storage from Android <= 11 backups: the encrypted API key
     cannot be decrypted after a restore (the Keystore key does not travel
     with the backup), so backing it up only leaks ciphertext. -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
</full-backup-content>
